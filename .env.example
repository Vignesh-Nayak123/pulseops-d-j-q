# Tunables read by config.py. docker-compose.yml sets the queue settings on the
# worker service directly and passes the SMTP settings through from .env. Copy
# this file to .env and adjust, or export variables in your shell for a
# non-Docker run.

# Redis connection. Inside compose this is redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0

# Visibility timeout in seconds. Must be larger than your slowest job, or
# healthy jobs get reaped and run twice.
VISIBILITY_TIMEOUT=30

# Retry policy. delay = BACKOFF_BASE * 2^(attempts-1), capped at BACKOFF_MAX.
# After MAX_ATTEMPTS failed deliveries (handler failures or timeouts) the job is
# dead-lettered.
MAX_ATTEMPTS=5
BACKOFF_BASE=2
BACKOFF_MAX=300

# Background loop intervals, seconds.
REAP_INTERVAL=1
PROMOTE_INTERVAL=1

# Worker idle poll sleep, seconds.
WORKER_IDLE_SLEEP=0.5

# How long finished job records live, seconds.
RESULT_TTL=3600

# Port each worker serves its Prometheus metrics on.
WORKER_METRICS_PORT=9100

# ---------------------------------------------------------------------------
# SMTP settings for the send_email job.
#
# Compose workers connect to Mailpit on the host at host.docker.internal:1025
# and use STARTTLS disabled. Nothing is delivered to real mailboxes. Docker
# Compose reads this file automatically when it is named .env; for a non-Docker
# run, use SMTP_HOST=localhost and export the variables in your shell. Never
# commit real credentials.
# ---------------------------------------------------------------------------
SMTP_HOST=host.docker.internal
SMTP_PORT=1025

# Leave blank for an unauthenticated local test server. For a real provider,
# use its SMTP hostname and an app-specific password, not your account password.
SMTP_USERNAME=
SMTP_PASSWORD=

# Envelope sender. This usually must be an address the SMTP provider allows.
SMTP_FROM=no-reply@localhost

# Set true for providers that require STARTTLS (commonly port 587).
SMTP_STARTTLS=false

# SMTP connection timeout in seconds.
SMTP_TIMEOUT=10
